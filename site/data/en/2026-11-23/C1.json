    "culture": {
      "text": {
        "id": 42,
        "title": "More sex, different endings: how fan fiction makes our dreams come true",
        "source": "The Guardian - Culture",
        "source_id": "guardian_culture",
        "category": "culture",
        "url": "https://www.theguardian.com/books/2026/nov/23/more-sex-different-endings-how-fan-fiction-makes-our-dreams-come-true",
        "published_at": "2026-11-23T12:30:30",
        "level": "C1",
        "slot_level": "C1",
        "source_level": "C1",
        "word_count": 1296,
        "duration_sec": null,
        "body_text": "Shortly after this year’s London book fair, rumours began to circulate of a seven-figure book deal for a rewrite of the wildly popular work of Harry Potter fan fiction All the Young Dudes.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "060f58eaf8e4cd3554c055e7f476c1f575d2a6a0",
        "summary": "A Harry Potter-inspired novel has earned its author more than £1m in a bidding war. What does this mean for the writers of fan fiction, and the platforms that host their passionate creations? Shortly after this year’s London book fair , rumours began to circulate of a seven-figure book deal for a rewrite of the wildly popular work of Harry Potter fan fiction All the Young Dudes. First published between 2017 and 2018 by user MsKingBean89 on the online platform Archive of Our Own, All the Young Dudes is arguably the most-read work of fan fiction of all time. Now it will be repackaged as a series under the pen name BN King, with the first novel, Wolfboy, due to be published in autumn 2027. This is by no means the first example of fan fiction crossing over into mainstream publishing: the bestselling debut of 2025, Alchemised, also started off as fan fiction based on the Harry Potter series, with some inspiration from The Handmaid’s Tale too. And nearly 15 years earlier, EL James published Fifty Shades of Grey, which began life as Twilight fan fiction before proceeding, in its new guise, to sell millions of copies worldwide.",
        "origin": "fresh",
        "badges": [],
