    "culture": {
      "text": {
        "id": 49,
        "title": "Is it true that … we only use 10% of our brains?",
        "source": "The Guardian - Science",
        "source_id": "guardian_science",
        "category": "culture",
        "url": "https://www.theguardian.com/lifeandstyle/2026/nov/23/is-it-true-we-only-use-10-per-cent-brain",
        "published_at": "2026-11-23T08:00:51",
        "level": "B1",
        "slot_level": "B1",
        "source_level": "B2",
        "word_count": 287,
        "duration_sec": null,
        "body_text": "This idea really bugs Dr Mary Spiller, senior lecturer in the University of East London’s Department of Psychology and Human Development, who’s shocked by how prevalent it remains, despite being untrue.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "273153a5bc58b5ff72fc8613d44dda71442d8f22",
        "summary": "The idea that we access a fraction of our cognitive potential goes back decades, but does medical science agree? This idea really bugs Dr Mary Spiller , senior lecturer in the University of East London’s Department of Psychology and Human Development, who’s shocked by how prevalent it remains, despite being untrue. Spiller says the myth’s origins can partly be traced to the work of William James, one of the founders of modern psychology, working in the late 19th and early 20th centuries. He wrote: “We are making use of only a small part of our possible mental and physical resources.”",
        "origin": "adjacent",
        "badges": [
          "Closest level: B2"
        ],
        "periods": [],
        "themes": [],
        "history_terms": [],
        "alt_text": "Is it true that … we only use 10% of our brains? — The Guardian - Science",
        "duration_formatted": "",
        "source_url": "https://www.theguardian.com/science/rss",
        "reading_time_min": 2
      },
