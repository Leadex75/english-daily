    "culture": {
      "text": {
        "id": 57,
        "title": "£10m ‘once-in-a-generation’ study to explore effects of children’s social media ban",
        "source": "The Guardian - Science",
        "source_id": "guardian_science",
        "category": "culture",
        "url": "https://www.theguardian.com/uk-news/2026/nov/18/social-media-ban-once-in-a-generation-study",
        "published_at": "2026-11-18T07:00:36",
        "level": "B2",
        "slot_level": "B2",
        "source_level": "B2",
        "word_count": 594,
        "duration_sec": null,
        "body_text": "Countries around the world are considering social media bans for children, but whether this would work in practice has been hotly debated. Now researchers are seeking answers through a major scientific study led by Wellcome, which will be the first of its kind.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "d1f3acf113bc560bed092effb1594c6ee23b5628",
        "summary": "Research to look at whether ban can make meaningful change in mental health and wellbeing for under-16s Countries around the world are considering social media bans for children, but whether this would work in practice has been hotly debated. Now researchers are seeking answers through a major scientific study led by Wellcome, which will be the first of its kind. Ten research projects will explore topics ranging from children’s mental health to their sleep and physical activity, comparing factors before and after the social media ban for children under 16 is introduced in the UK in spring 2027.",
        "origin": "fresh",
