    "culture": {
      "text": {
        "id": 48,
        "title": "IPCC report delay will threaten global effort to tackle climate crisis, says top scientist",
        "source": "The Guardian - Science",
        "source_id": "guardian_science",
        "category": "culture",
        "url": "https://www.theguardian.com/science/2026/nov/19/ipcc-report-delay-climate-crisis-scientist",
        "published_at": "2026-11-19T07:16:45",
        "level": "B2",
        "slot_level": "B2",
        "source_level": "B2",
        "word_count": 1248,
        "duration_sec": null,
        "body_text": "Climate science is “foundational” to the Paris agreement and worldwide progress on tackling global heating, and attempts to delay new scientific reports threaten global cooperation on tackling the crisis, one of the world’s leading climate scientists has warned.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "1b4f2c91b645b6537ec3c575415302d1cb08ba31",
        "summary": "Johan Rockström, one of world’s leading climate experts, says slowing down scientific work puts cooperation at risk Climate science is “foundational” to the Paris agreement and worldwide progress on tackling global heating, and attempts to delay new scientific reports threaten global cooperation on tackling the crisis, one of the world’s leading climate scientists has warned. Johan Rockström, the director of the Potsdam Institute for Climate Impact Research, said the world’s leading body of climate scientists, the Intergovernmental Panel on Climate Change, must be allowed to work as quickly as possible on its next comprehensive assessment of global knowledge of the climate systems .",
        "origin": "fresh",
