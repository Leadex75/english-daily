    "culture": {
      "text": {
        "id": 40,
        "title": "Melania: the series review – so bad it robbed me of my capacity to discern time and space",
        "source": "The Guardian - Culture",
        "source_id": "guardian_culture",
        "category": "culture",
        "url": "https://www.theguardian.com/tv-and-radio/2026/nov/20/melania-review-tv-documentary-prime",
        "published_at": "2026-11-20T15:38:39",
        "level": "B1",
        "slot_level": "B1",
        "source_level": "B1",
        "word_count": 735,
        "duration_sec": null,
        "body_text": "Previously on Melania: earlier this year – either because it found her a compelling subject, or because it wanted to flatter the president before a potentially destructive upcoming antitrust trial – Amazon spent $75m (£57m) to make and market a theatrically released documentary about Melania Trump. I’m telling you this for two reasons.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "945c1e47137395f9f5927ff6531493be2724e5f2",
        "summary": "The first lady’s two-part TV documentary is a dead-eyed advert that barely manages to masquerade as entertainment. Calling it thin gruel would be an insult to the gruel industry Previously on Melania: earlier this year – either because it found her a compelling subject, or because it wanted to flatter the president before a potentially destructive upcoming antitrust trial – Amazon spent $75m (£57m) to make and market a theatrically released documentary about Melania Trump. I’m telling you this for two reasons. First, because you didn’t watch the Melania film. Nobody did, except for journalists who sat in otherwise empty cinemas and (if reports are to believed) people who responded to Craigslist ads offering them $50 to see it. The second reason is because Melania is a series now.",
        "origin": "fresh",
        "badges": [],
        "periods": [],
        "themes": [],
        "history_terms": [],
