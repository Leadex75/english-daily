    "culture": {
      "text": {
        "id": 51,
        "title": "‘I felt a zap race through my body’: what happens when someone is hit by lightning?",
        "source": "The Guardian - Science",
        "source_id": "guardian_science",
        "category": "culture",
        "url": "https://www.theguardian.com/science/2026/nov/28/what-happens-when-someone-is-hit-by-lightning",
        "published_at": "2026-11-27T14:00:12",
        "level": "B1",
        "slot_level": "B1",
        "source_level": "B2",
        "word_count": 1165,
        "duration_sec": null,
        "body_text": "Caitlin Thomas recalls knowing that something terrible had happened but not fully understanding what. She and her partner had arrived at a music festival some 270km north of Melbourne in the early afternoon and began setting up their tents and a gazebo for shade when the sky suddenly turned dark and the rain became incredibly heavy.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "709f666b59525bc85ad950ab3ba8f4a1b620340f",
        "summary": "Tens of thousands of people experience strikes each year. What are the effects of a current five times hotter than the sun – and how can you keep safe? Caitlin Thomas recalls knowing that something terrible had happened but not fully understanding what. She and her partner had arrived at a music festival some 270km north of Melbourne in the early afternoon and began setting up their tents and a gazebo for shade when the sky suddenly turned dark and the rain became incredibly heavy. A huge gust of wind picked up and Thomas asked her partner to hold on to the gazebo so it wouldn’t fly away. “He then asked me to hold on to it also so he could crack open his beer.”",
        "origin": "adjacent",
        "badges": [
          "Closest level: B2"
        ],
        "periods": [],
        "themes": [],
        "history_terms": [],
        "alt_text": "‘I felt a zap race through my body’: what happens when someone is hit by lightning? — The Guardian - Science",
