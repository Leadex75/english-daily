    "culture": {
      "text": {
        "id": 42,
        "title": "Man Theft Auto – why did so few women review GTA VI, the biggest video game of the decade?",
        "source": "The Guardian - Culture",
        "source_id": "guardian_culture",
        "category": "culture",
        "url": "https://www.theguardian.com/games/2026/nov/24/man-theft-auto-why-did-so-few-women-review-gta-vi-the-biggest-video-game-of-the-decade",
        "published_at": "2026-11-24T11:00:43",
        "level": "B2",
        "slot_level": "B2",
        "source_level": "B2",
        "word_count": 690,
        "duration_sec": null,
        "body_text": "Grand Theft Auto VI is now the biggest video game launch of all time, and is likely to become the biggest video game of all time.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "3d75880ad8cb4158351cdb98cef026ea494e8191",
        "summary": "Given that this is the first Grand Theft Auto in 30 years with a female protagonist, you might have expected to hear from female critics. But you would have expected mostly in vain Grand Theft Auto VI is now the biggest video game launch of all time, and is likely to become the biggest video game of all time. It’s a once-in-a-lifetime event, a phenomenon that will shape games as a medium and pop culture at large for years to come, set against the backdrop of its developers fighting for their rights at studio Rockstar Games . It has snatched sales and streaming records and become the best-reviewed game ever (pulling ahead of 1998’s The Legend of Zelda: Ocarina of Time). It’s also the first GTA game with a female protagonist, who also happens to be a woman of colour. Yet very few women (and seemingly no women of colour) played and reviewed it before release. When GTA IV’s review embargo lifted on 18 November, the gender imbalance was immediately obvious. Out of 156 reviewers, only six appeared to be women. As journalist Lex Luddy noted in a BlueSky post , that is 3.8%.",
        "origin": "fresh",
        "badges": [],
        "periods": [],
        "themes": [],
        "history_terms": [],
        "alt_text": "Man Theft Auto – why did so few women review GTA VI, the biggest video game of the decade? — The Guardian - Culture",
        "duration_formatted": "",
        "source_url": "https://www.theguardian.com/culture/rss",
        "reading_time_min": 4
      },
      "audio": {
