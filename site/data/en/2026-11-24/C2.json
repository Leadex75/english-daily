          "<span class=\"Latn\" lang=\"en\" about=\"#mwt126\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/laconic#English\" class=\"mw-selflink-fragment\">laconic</a></span>"
