    "news": {
      "text": {
        "id": 2,
        "title": "Climate talks fail",
        "source": "BBC Learning English from the News (text)",
        "source_id": "bbc_learning_english_from_the_news_text",
        "category": "news",
        "url": "http://www.bbc.co.uk/programmes/p0ppw13c",
        "published_at": "2026-11-25T15:04:00",
        "level": "A2",
        "slot_level": "A2",
        "source_level": "B1",
        "word_count": 143,
        "duration_sec": null,
        "body_text": "COP31 climate conference ends without agreement. Many countries were unhappy because the draft agreement didn’t include the term ‘fossil fuels’. The COP31 talks held in Turkey were the latest in a yearly conference between UN nations to plan and agree commitments and action on climate change.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "006859b04ae0e744c2eb1c632b90f1357c1327cf",
        "summary": "The COP31 talks held in Turkey were the latest in a yearly conference between UN nations to plan and agree commitments and action on climate change. This was the longest climate conference ever, but the talks collapsed on Sunday after countries were unable to reach an agreement. Many countries, including EU countries and Pacific island nations were unhappy because the draft agreement didn’t include the term ‘fossil fuels’. Another disagreement was over payments to poorer countries to help them to adapt to the impacts of rising temperatures. Many of these countries wanted the agreement to say exactly how much financial help richer countries would commit to. Get a free worksheet for this episode here: https://www.bbc.co.uk/learningenglish/english/features/learning-english-from-the-news_2026/261125",
        "origin": "adjacent",
        "badges": [
          "Closest level: B1"
        ],
