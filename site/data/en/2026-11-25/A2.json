    "culture": {
      "text": {
        "id": 47,
        "title": "‘I said no thanks to the casting couch. But other actresses had problems’: Jane Alexander on 50 years of stardom",
        "source": "The Guardian - Culture",
        "source_id": "guardian_culture",
        "category": "culture",
        "url": "https://www.theguardian.com/film/2026/nov/25/jane-alexander-interview",
        "published_at": "2026-11-25T12:00:56",
        "level": "A2",
        "slot_level": "A2",
        "source_level": "B1",
        "word_count": 1983,
        "duration_sec": null,
        "body_text": "Jane Alexander will never forget the play that won her a Tony award, a husband and her first film role. The Great White Hope, which ran on Broadway from 1968 to 1970, was based on the life of Black boxer Jack Johnson, who in 1908 became world heavyweight champion in segregated America.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "ffe2c6f556b171c62c722be03c330d42aea312e5",
        "summary": "The Great White Hope, All the President’s Men, Kramer vs Kramer … Alexander has a CV most actors can only dream of. She talks us through the highs and lows – including a ‘beautiful’ encounter with Muhammad Ali Jane Alexander will never forget the play that won her a Tony award, a husband and her first film role. The Great White Hope, which ran on Broadway from 1968 to 1970, was based on the life of Black boxer Jack Johnson, who in 1908 became world heavyweight champion in segregated America. Alexander played Eleanor, a white woman married to an African American boxer also called Jack, at a time when interracial marriages were still illegal in many states. Decades later, when the play opened, the US supreme court had only recently struck down all remaining bans – and Alexander received hate mail and death threats for the role.",
        "origin": "adjacent",
        "badges": [
          "Closest level: B1",
          "Outside preferred window"
        ],
        "periods": [],
        "themes": [],
        "history_terms": [],
        "alt_text": "‘I said no thanks to the casting couch. But other actresses had problems’: Jane Alexander on 50 years of stardom — The Guardian - Culture",
