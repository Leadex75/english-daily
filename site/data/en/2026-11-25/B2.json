    "culture": {
      "text": {
        "id": 50,
        "title": "Tidal bans 100% AI-generated music with plans to delete more than 27m tracks",
        "source": "The Guardian - Culture",
        "source_id": "guardian_culture",
        "category": "culture",
        "url": "https://www.theguardian.com/music/2026/nov/25/tidal-streaming-service-bans-ai-generated-music",
        "published_at": "2026-11-25T02:12:22",
        "level": "B2",
        "slot_level": "B2",
        "source_level": "B2",
        "word_count": 444,
        "duration_sec": null,
        "body_text": "The music streaming service Tidal has announced it will ban entirely AI-generated music from its platform and remove millions of songs, saying AI music “diverts streams and royalties away from the artists, and confuses fans”.",
        "audio_url": null,
        "description": null,
        "license": "proprietary",
        "attribution": null,
        "truncated": true,
        "guid_hash": "dada9b531624ad840e38d58309f5b375825ab930",
        "summary": "Streaming service says 43% of uploads to platform in past 90 days were made entirely by artificial intelligence The music streaming service Tidal has announced it will ban entirely AI-generated music from its platform and remove millions of songs, saying AI music “diverts streams and royalties away from the artists, and confuses fans”. “To ensure Tidal remains the best place for artists to share their work, and for listeners to enjoy it, we’re removing all tracks that we determine are 100% AI generated,” the company announced on Tuesday.",
        "origin": "fresh",
        "badges": [],
        "periods": [],
        "themes": [],
